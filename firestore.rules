// Complete Firestore rules for the site. Paste ALL of this into
// Firebase Console → Firestore Database → Rules (replacing what's there) and Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins sign in with email + password. Devotees get anonymous accounts on public
    // pages, and anyone can create a password account via the API, so admin = these
    // emails only. To add an admin: create their user in Authentication, then add here.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['anupam2k321@gmail.com'];
    }

    // An admin has switched leaderboard `id` live at /admin/leaderboards.
    function boardLive(id) {
      let path = /databases/$(database)/documents/leaderboards/$(id);
      return exists(path) && get(path).data.live == true;
    }

    match /pujaBookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // One doc per leaderboard: { live: bool, updatedAt, updatedBy }.
    match /leaderboards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sadhanaEntries/{entryId} {
      // "YYYY-MM-DD" → midnight UTC of that date.
      function dayOf(d) {
        let p = d.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }
      // True only for today or yesterday in India (IST = UTC+5:30).
      function isTodayOrYesterdayIST(d) {
        let istNow = request.time + duration.value(330, 'm');
        return dayOf(d) <= istNow && dayOf(d) > istNow - duration.value(2, 'd');
      }
      function validEntry(e) {
        return e.keys().hasOnly(['uid', 'name', 'date', 'rounds', 'finishedAt', 'hearingMin', 'readingMin', 'deepDan', 'updatedAt'])
          && e.uid == request.auth.uid
          && entryId == request.auth.uid + '_' + e.date
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isTodayOrYesterdayIST(e.date)
          && e.name is string && e.name.size() > 0 && e.name.size() <= 40
          && e.rounds is int && e.rounds >= 0 && e.rounds <= 64
          && e.finishedAt is string && e.finishedAt.matches('^([0-9]{2}:[0-9]{2})?$')
          && e.hearingMin is int && e.hearingMin >= 0 && e.hearingMin <= 600
          && e.readingMin is int && e.readingMin >= 0 && e.readingMin <= 600
          && (!('deepDan' in e) || e.deepDan is bool)
          && e.updatedAt == request.time;
      }

      // Hidden boards are visible (and usable, for testing) by admins only.
      allow read: if boardLive('sadhana') || isAdmin();
      allow create, update: if request.auth != null
        && (boardLive('sadhana') || isAdmin())
        && validEntry(request.resource.data);
      allow delete: if false;
    }
  }
}
