// Sadhana leaderboard rules — paste this `match` block into your existing Firestore rules
// (Firebase Console → Firestore → Rules), inside `match /databases/{database}/documents { ... }`.
// Also enable Anonymous sign-in: Firebase Console → Authentication → Sign-in method → Anonymous.

    match /sadhanaEntries/{entryId} {
      // "YYYY-MM-DD" → midnight UTC of that date.
      function dayOf(d) {
        let p = d.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }
      // True only for today or yesterday in India (IST = UTC+5:30).
      function isTodayOrYesterdayIST(d) {
        let istNow = request.time + duration.value(330, 'm');
        return dayOf(d) <= istNow && dayOf(d) > istNow - duration.value(2, 'd');
      }
      function validEntry(e) {
        return e.keys().hasOnly(['uid', 'name', 'date', 'rounds', 'finishedAt', 'hearingMin', 'readingMin', 'deepDan', 'updatedAt'])
          && e.uid == request.auth.uid
          && entryId == request.auth.uid + '_' + e.date
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isTodayOrYesterdayIST(e.date)
          && e.name is string && e.name.size() > 0 && e.name.size() <= 40
          && e.rounds is int && e.rounds >= 0 && e.rounds <= 64
          && e.finishedAt is string && e.finishedAt.matches('^([0-9]{2}:[0-9]{2})?$')
          && e.hearingMin is int && e.hearingMin >= 0 && e.hearingMin <= 600
          && e.readingMin is int && e.readingMin >= 0 && e.readingMin <= 600
          && (!('deepDan' in e) || e.deepDan is bool)
          && e.updatedAt == request.time;
      }

      allow read: if true;
      allow create, update: if request.auth != null && validEntry(request.resource.data);
      allow delete: if false;
    }
